---
interface Props {
  title: string;
  description: string;
  tags: string[];
}

const { title, description, tags } = Astro.props;
---

<div class="group relative rounded-2xl border border-slate-800 bg-slate-900/50 p-6 hover:border-emerald-500/50 hover:bg-slate-900 transition flex flex-col justify-between">
  <div>
    <h3 class="text-xl font-semibold text-white group-hover:text-emerald-400 transition">{title}</h3>
    <p class="mt-3 text-sm text-slate-400 leading-relaxed">{description}</p>
    
    <div class="mt-4 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="text-xs px-2.5 py-1 rounded-md bg-slate-800 text-slate-300 border border-slate-700/60 font-mono">
          {tag}
        </span>
      ))}
    </div>
  </div>

  <div class="mt-6 flex items-center gap-4 text-sm font-medium">
    <a href="#" class="text-emerald-400 hover:underline inline-flex items-center gap-1">
      Ver demo &rarr;
    </a>
    <a href="#" class="text-slate-400 hover:text-white transition">
      Código
    </a>
  </div>
</div>