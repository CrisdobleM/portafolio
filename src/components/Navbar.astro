---
// src/components/Navbar.astro
---

<header class="w-full bg-gray-950/90 backdrop-blur border-b border-gray-800 sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logotipo o Nombre -->
    <a href="/portafolio/" class="text-lg font-bold text-white hover:text-blue-400 transition">
      CrisdobleM
    </a>

    <!-- Enlaces de navegación -->
    <nav class="flex items-center gap-6 text-sm font-medium text-gray-300">
      <a href="/portafolio/" class="hover:text-white transition">
        Inicio
      </a>

      <!-- Menú Desplegable: Proyectos -->
      <div class="relative group">
        <button 
          type="button"
          class="flex items-center gap-1.5 py-2 hover:text-white transition focus:outline-none"
        >
          <span>Proyectos</span>
          <svg class="w-4 h-4 text-gray-400 group-hover:text-white transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Submenú flotante -->
        <div class="absolute left-0 mt-1 w-64 rounded-xl bg-gray-900 border border-gray-800 shadow-2xl py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
          <a 
            href="/portafolio/creatividad" 
            class="block px-4 py-2.5 text-xs text-gray-300 hover:bg-gray-800 hover:text-blue-400 transition"
          >
            Creatividad
          </a>
          <a 
            href="/portafolio/proyecto-de-vida" 
            class="block px-4 py-2.5 text-xs text-gray-300 hover:bg-gray-800 hover:text-emerald-400 transition"
          >
            Proyecto de Vida
          </a>
          <a 
            href="/portafolio/emprendimiento" 
            class="block px-4 py-2.5 text-xs text-gray-300 hover:bg-gray-800 hover:text-purple-400 transition"
          >
            Emprendimiento Social y Económico
          </a>
          <a 
            href="/portafolio/proyectos" 
            class="block px-4 py-2.5 text-xs text-gray-300 hover:bg-gray-800 hover:text-cyan-400 transition"
          >
            Proyectos de Software y Prototipos
          </a>
          <a 
            href="/portafolio/plan-de-carrera" 
            class="block px-4 py-2.5 text-xs text-gray-300 hover:bg-gray-800 hover:text-amber-400 transition"
          >
            Plan de Carrera
          </a>
        </div>
      </div>

      <!-- Botón Descargar CV -->
      <a 
        href="/portafolio/CV_profecional.pdf" 
        download 
        class="px-4 py-1.5 rounded-lg border border-emerald-500/60 text-emerald-400 hover:bg-emerald-500/10 transition text-xs font-semibold"
      >
        Descargar CV
      </a>
    </nav>
  </div>
</header>