---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
---

<Layout title="Cristian | Portafolio Profesional">
  <Navbar />

  <main class="grow pt-24 max-w-6xl mx-auto px-6 w-full space-y-28">

    <!-- 1. INICIO Y DATOS PERSONALES -->
    <section id="inicio" class="flex flex-col-reverse md:flex-row items-center justify-between gap-12 py-8">
      <div class="flex-1 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Disponible para nuevos proyectos
        </div>
        
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white">
  Hola, soy <span class="text-transparent bg-clip-text bg-linear-to-r from-emerald-400 to-cyan-400">Cristian</span>
</h1>
        
        <p class="text-lg text-slate-300 leading-relaxed">
          Ingeniero y desarrollador enfocado en construir software escalable, interfaces modernas y soluciones tecnológicas eficientes.
        </p>

        <!-- Datos personales -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm text-slate-400 border-t border-slate-800 pt-4">
          <div><strong class="text-slate-200">Ubicación:</strong> México</div>
          <div><strong class="text-slate-200">Especialidad:</strong> Desarrollo Web & Sistemas</div>
          <div><strong class="text-slate-200">Email:</strong> contacto@cristian.dev</div>
          <div><strong class="text-slate-200">Idiomas:</strong> Español (Nativo), Inglés</div>
        </div>

        <div class="flex flex-wrap gap-4 pt-2">
          <a href="#proyectos" class="px-6 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold shadow-lg shadow-emerald-500/20 transition">
            Ver Proyectos
          </a>
          <a href="#cv" class="px-6 py-3 rounded-xl border border-slate-700 hover:border-slate-500 text-white font-medium transition">
            Ver Experiencia / CV
          </a>
        </div>
      </div>

      <!-- Foto de perfil -->
      <div class="relative group">
        <div class="absolute -inset-1 rounded-full bg-linear-to-r from-emerald-500 to-cyan-500 opacity-30 blur group-hover:opacity-60 transition duration-500"></div>
        <img 
          src="cristian.jpg" 
          alt="Foto de Cristian" 
          class="relative w-56 h-56 sm:w-64 sm:h-64 rounded-full object-cover border-2 border-slate-700 shadow-2xl bg-slate-900"
          onerror="this.src='https://ui-avatars.com/api/?name=Cristian&background=0f172a&color=10b981&size=256'"
        />
      </div>
    </section>

    <!-- 2. PROYECTOS -->
    <section id="proyectos" class="space-y-8 scroll-mt-24">
      <div>
        <h2 class="text-3xl font-bold text-white tracking-tight">Proyectos Realizados</h2>
        <p class="text-slate-400 mt-2 text-sm">Selección de proyectos de desarrollo, interfaces y arquitectura de software.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <ProjectCard 
          title="Sistema Web E-Commerce" 
          description="Plataforma de ventas con catálogo responsivo, carrito dinámico y pasarela de compras."
          tags={["Astro", "Tailwind CSS", "JavaScript"]}
        />
        <ProjectCard 
          title="API REST & Backend" 
          description="Arquitectura de servidor modular con autenticación, endpoints optimizados y base de datos."
          tags={["Python", "FastAPI", "SQL"]}
        />
        <ProjectCard 
          title="Dashboard de Monitoreo & IoT" 
          description="Monitoreo de datos en tiempo real mediante sensores, dashboards interactivos y protocolos seriales."
          tags={["C++", "ESP32", "WebSockets"]}
        />
      </div>
    </section>

    <!-- 3. CV PROFESIONAL -->
    <section id="cv" class="space-y-8 scroll-mt-24">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-3xl font-bold text-white tracking-tight">Currículum Profesional</h2>
          <p class="text-slate-400 mt-2 text-sm">Educación, trayectoria y principales competencias técnicas.</p>
        </div>
        <a 
          href="/cv-cristian.pdf" 
          download 
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-sm font-semibold text-white border border-slate-700 transition w-fit"
        >
          <span>Descargar PDF</span> &darr;
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Trayectoria -->
<div class="space-y-6">
  <!-- Primer elemento -->
  <div class="relative">
    <div class="absolute -left-5 top-1.5 w-2.5 h-2.5 rounded-full bg-emerald-400"></div>
    <h4 class="font-medium text-white">Ingeniería en Computación / Sistemas</h4>
    <p class="text-xs text-slate-400">Formación Académica Universitaria</p>
    <p class="text-sm text-slate-300 mt-2">Especialización en desarrollo de software, algoritmos, bases de datos y redes.</p>
  </div>

  <!-- Segundo elemento -->
  <div class="relative">
    <div class="absolute -left-5 top-1.5 w-2.5 h-2.5 rounded-full bg-slate-600"></div>
    <h4 class="font-medium text-white">Desarrollador de Software</h4>
    <p class="text-xs text-slate-400">Proyectos Universitarios e Independientes</p>
    <p class="text-sm text-slate-300 mt-2">Desarrollo de frontends optimizados, microservicios backend y automatización.</p>
  </div>
</div>

        <!-- Habilidades -->
        <div class="space-y-6">
          <h3 class="text-lg font-semibold text-emerald-400">Habilidades Técnicas</h3>
          <div class="space-y-4">
            <div>
              <div class="flex justify-between text-sm mb-1 text-slate-300">
                <span>Frontend (HTML5, CSS3, Tailwind, Astro)</span>
                <span class="text-slate-500 font-mono">Avanzado</span>
              </div>
              <div class="w-full bg-slate-800 rounded-full h-2">
                <div class="bg-emerald-400 h-2 rounded-full w-[90%]"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-sm mb-1 text-slate-300">
                <span>Backend & APIs (Python, FastAPI, Node)</span>
                <span class="text-slate-500 font-mono">Intermedio - Avanzado</span>
              </div>
              <div class="w-full bg-slate-800 rounded-full h-2">
                <div class="bg-emerald-400 h-2 rounded-full w-[80%]"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-sm mb-1 text-slate-300">
                <span>Bases de Datos & SQL</span>
                <span class="text-slate-500 font-mono">Avanzado</span>
              </div>
              <div class="w-full bg-slate-800 rounded-full h-2">
                <div class="bg-emerald-400 h-2 rounded-full w-[85%]"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. RETROALIMENTACIÓN / CONTACTO -->
    <section id="feedback" class="space-y-8 pb-16 scroll-mt-24">
      <div class="max-w-2xl mx-auto text-center space-y-2">
        <h2 class="text-3xl font-bold text-white tracking-tight">Actividades & Retroalimentación</h2>
        <p class="text-slate-400 text-sm">Déjame tus comentarios, observaciones sobre los proyectos o una propuesta laboral.</p>
      </div>

      <form 
        action="https://api.web3forms.com/submit" 
        method="POST" 
        class="max-w-xl mx-auto bg-slate-900/60 p-8 rounded-2xl border border-slate-800 space-y-5"
      >
        <input type="hidden" name="access_key" value="TU_ACCESS_KEY_DE_WEB3FORMS" />
        
        <div>
          <label for="name" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Tu Nombre</label>
          <input 
            type="text" 
            name="name" 
            id="name" 
            required 
            placeholder="Ej. Juan Pérez" 
            class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-emerald-500 transition"
          />
        </div>

        <div>
          <label for="email" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Tu Correo</label>
          <input 
            type="email" 
            name="email" 
            id="email" 
            required 
            placeholder="correo@ejemplo.com" 
            class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-emerald-500 transition"
          />
        </div>

        <div>
          <label for="message" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Mensaje o Feedback</label>
          <textarea 
            name="message" 
            id="message" 
            rows="4" 
            required 
            placeholder="Escribe aquí tu opinión o comentarios sobre los proyectos..." 
            class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-emerald-500 transition resize-none"
          ></textarea>
        </div>

        <button 
          type="submit" 
          class="w-full py-3.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-sm tracking-wide transition shadow-lg shadow-emerald-500/10 cursor-pointer"
        >
          Enviar Retroalimentación
        </button>
      </form>
    </section>

  </main>

  <Footer />
</Layout>